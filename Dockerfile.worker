# Agents Verse — audit worker image. Runs the Inngest worker (lib/inngest/worker-entrypoint.ts),
# which executes the durable audit pipeline: PageSpeed (fetch) + Playwright screenshot + Gemini
# vision. Based on the official Playwright image so Chromium (matching the `playwright` npm
# version, 1.60.0) is preinstalled at /ms-playwright. The `web` image stays slim (no Chromium).
FROM mcr.microsoft.com/playwright:v1.60.0-noble
WORKDIR /app

# Browsers ship in the base image (PLAYWRIGHT_BROWSERS_PATH=/ms-playwright) — don't re-download.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
# ws's native accelerators (utf-8-validate/bufferutil) are compiled by node-gyp during `npm ci`, which
# needs a C/C++ toolchain + python3 the slim Playwright base doesn't ship (fails with "not found: make").
# Install build-essential before install so the worker image builds reproducibly.
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential python3 \
  && rm -rf /var/lib/apt/lists/*
RUN npm ci
# Claude Code CLI for demo generation and the other agent runs: the worker shells to `claude`, which runs
# on the user's subscription — no metered API key. By default compose points it at the 9router gateway
# (ANTHROPIC_BASE_URL=http://9router:20128 + ANTHROPIC_AUTH_TOKEN), which holds and auto-refreshes the
# provider auth in its own volume so a worker rebuild can't drop it. Clearing ANTHROPIC_BASE_URL in ./.env
# falls back to talking to Anthropic directly on CLAUDE_CODE_OAUTH_TOKEN.
RUN npm i -g @anthropic-ai/claude-code
COPY . .

# Outbound connect() worker — no inbound port needed. tsx runs the TS entrypoint (devDep present).
CMD ["npx", "tsx", "lib/inngest/worker-entrypoint.ts"]
