# Agents Verse — environment manifest. Copy to `.env.local` and fill real values.
# `.env.local` is git-ignored; never commit real secrets.

# --- Supabase Postgres ---------------------------------------------------
# App runtime: Transaction pooler (port 6543). MUST pair with prepare:false in the
# postgres-js client — the pooler hands out a different backend per statement, so
# server-side prepared statements break ("prepared statement does not exist") hours
# into production. See lib/db/client.ts.
DATABASE_URL=postgresql://postgres.[REF]:[PW]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Migrations / seed: Direct/Session connection (port 5432) — supports prepared
# statements + session features that drizzle-kit needs.
DIRECT_URL=postgresql://postgres.[REF]:[PW]@aws-0-[REGION].pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # backend only — full DB access, never expose to client
NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # client-safe

# --- Data source toggle --------------------------------------------------
# false (or unset) → repositories read the mock AV singleton (app runs with no DB).
# true             → repositories read Postgres. Flip per-screen once verified.
USE_DB=false

# --- Better Auth (Phase 5) ----------------------------------------------
BETTER_AUTH_SECRET=                                # >= 32 random chars
BETTER_AUTH_URL=http://localhost:3000

# --- Founder seed account (Phase 3) -------------------------------------
FOUNDER_EMAIL=founder@agentsverse.ai
FOUNDER_PASSWORD=                                  # set a strong value before seeding

# --- Google Places (Phase 8) --------------------------------------------
GOOGLE_MAPS_API_KEY=
# Default seed market + cost guard (configurable)
DISCOVERY_DEFAULT_INDUSTRY=dentists
DISCOVERY_DEFAULT_CITY=Austin TX
DISCOVERY_DAILY_CAP=450                            # app-side QPD guard; also cap in Cloud Console

# --- Deferred to a later plan (NOT used in Foundation + Discovery) -------
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# REDIS_URL=redis://localhost:6379
