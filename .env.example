# Agents Verse — environment manifest. Copy to `.env.local` and fill real values.
# `.env.local` is git-ignored; never commit real secrets.

# --- Self-hosted Postgres ------------------------------------------------
# These three are read by the `db` service (docker-compose) on FIRST boot to initialize the
# cluster. They MUST match the credentials embedded in DATABASE_URL below.
# Generate a strong password: `openssl rand -base64 32`
POSTGRES_USER=agentsverse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PW
POSTGRES_DB=agentsverse

# Single direct connection used by the app runtime, drizzle-kit migrations, and the seed.
# Inside docker-compose the host is the service name `db`; for host-run local dev (npm run dev
# against a local Postgres) use `localhost:5432` instead. No pooler/DIRECT_URL split —
# self-hosted Postgres IS the direct connection.
DATABASE_URL=postgresql://agentsverse:CHANGE_ME_STRONG_PW@db:5432/agentsverse

# --- Data source toggle --------------------------------------------------
# false (or unset) → repositories read the mock AV singleton (app runs with no DB).
# true             → repositories read Postgres. Flip per-screen once verified.
USE_DB=false

# --- Better Auth (Phase 5) ----------------------------------------------
BETTER_AUTH_SECRET=                                # >= 32 random chars
BETTER_AUTH_URL=http://localhost:3000

# --- Founder seed account (Phase 3) -------------------------------------
# Sign-up is disabled (the founder is the only account). FOUNDER_PASSWORD is REQUIRED in DB mode:
# the seed SKIPS founder creation when it is empty (no fallback — a default would be a public
# credential), so you cannot log in until it is set and the seed re-runs (it re-runs on every boot).
FOUNDER_EMAIL=founder@agentsverse.ai
FOUNDER_PASSWORD=                                  # set a strong value before seeding
# Seed business fixtures (leads/audits/demos/deals/requests) alongside the org chart. Leave false
# for a clean production start; set true for a populated showcase dashboard.
SEED_DEMO_DATA=false

# --- Google Places (Phase 8) --------------------------------------------
GOOGLE_MAPS_API_KEY=
# Default seed market + cost guard (configurable)
DISCOVERY_DEFAULT_INDUSTRY=dentists
DISCOVERY_DEFAULT_CITY=Austin TX
DISCOVERY_DAILY_CAP=450                            # app-side QPD guard; also cap in Cloud Console

# --- Audit subsystem (Subsystem 2) --------------------------------------
# PageSpeed Insights (Lighthouse). Separate key; if blank the client falls back to
# GOOGLE_MAPS_API_KEY (same Google Cloud project, with the PageSpeed API enabled).
GOOGLE_PAGESPEED_API_KEY=
# Gemini vision scoring (runs in the worker). Model is overridable — set to a current
# vision-capable model id if the default has changed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Self-hosted Inngest (durable audit jobs). web sends events; worker runs them via connect().
INNGEST_EVENT_KEY=                                 # required when INNGEST_DEV=0
INNGEST_SIGNING_KEY=                               # required when INNGEST_DEV=0
INNGEST_DEV=0                                       # 1 for local `inngest dev` (no keys)
INNGEST_BASE_URL=http://inngest:8288               # inngest server (compose service)
INNGEST_DATABASE_URL=                              # Inngest server state; may reuse DATABASE_URL
AUDIT_CONCURRENCY=2                                 # max parallel audits on the VPS (OOM guard)
CLAUDE_AGENT_CONCURRENCY=2                          # max parallel `claude` CLI runs across the worker functions (demo-gen/build/outreach/support/reply)

# --- Demo generation (Subsystem 3) --------------------------------------
# The worker shells the `claude` CLI on the Claude subscription (no metered API key). Two ways to
# provide a backend — pick ONE:
#
# A) Direct subscription: generate a long-lived token with `claude setup-token` and set:
# CLAUDE_CODE_OAUTH_TOKEN=                          # NOTE: a worker rebuild drops anything not in env
#
# B) 9router gateway (recommended — persists + auto-refreshes provider auth in its own volume, and
#    can fall back to a free Claude provider). The compose `worker` already sets
#    ANTHROPIC_BASE_URL=http://9router:20128. After the one-time dashboard setup at
#    http://localhost:20128 (log in with INITIAL_PASSWORD, connect Claude Code OAuth + Kiro as a
#    fallback combo, create an API key), fill these:
# NOTE: JWT_SECRET + INITIAL_PASSWORD go in `./.env` (compose's interpolation file), NOT here —
# the 9router container is least-privilege and no longer reads .env.local.
JWT_SECRET=                                          # 9router admin: `openssl rand -hex 32` (set in ./.env)
INITIAL_PASSWORD=                                    # 9router dashboard login, first run (set in ./.env)
ANTHROPIC_BASE_URL=                                  # host-run dev only. In Docker, compose defaults web+worker to http://9router:20128; override (or blank, for the direct-subscription fallback) via ./.env — .env.local cannot override it
ANTHROPIC_AUTH_TOKEN=                                # the 9router API key (the `claude` CLI sends it)
AGENT_MODEL_OPUS=                                    # the 9router combo/model id mapped for opus work (demo-gen)
AGENT_MODEL_SONNET=                                  # sonnet model id for Closer/Echo/Mira/Cipher + the assistant chat (e.g. Kiro's free kr/claude-sonnet-4.5). Host-run dev only; in Docker override via ./.env (compose defaults to cc/claude-sonnet-4-6)

# --- Assistant chat (the ChatWidget Q&A bubble) — web-side. Reuses the gateway above
#     (ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN + AGENT_MODEL_SONNET). Unset on `web` => the widget
#     degrades to its built-in rule-based replies. It answers questions only; no live account data.

# --- Outreach email (Echo, Phase 5) — the project's ONLY paid key. Unset => outreach degrades to a
#     toast and the rest of the pipeline still runs to demo. Sending needs BOTH the key and a real From.
RESEND_API_KEY=                                      # Resend API key (free tier ok); CAN-SPAM applies
OUTREACH_FROM=                                       # verified sender, e.g. "Agents Verse <hello@your-domain.com>"
OUTREACH_REPLY_TO=                                   # optional reply-to + unsubscribe mailbox (defaults to OUTREACH_FROM)
APP_URL=                                             # public origin for demo links in emails (defaults to BETTER_AUTH_URL)

# --- Inbound replies (Resend inbound webhook, Phase 6). Unset => /api/inbound returns 503 and replies
#     stay founder-paste. When set, Resend POSTs client replies here; the Closer auto-interprets them.
RESEND_INBOUND_SECRET=                               # Svix signing secret for the inbound webhook ("whsec_...")

# --- Autonomous pipeline throttle. Bounds how many pipeline runs discovery auto-starts per day so a big
#     discovery batch can't exhaust the Claude-CLI burst budget. 0/unset => no app-side cap (each
#     auto-started run spends real opus time — keep a cap unless you mean it).
PIPELINE_DAILY_CAP=20
